# Node dependencies and package-manager caches
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.npm/
/.pnpm-store/

# Generated framework/build output and test coverage
/.next/
/.vinext/
/dist/
/out/
/coverage/
*.tsbuildinfo
next-env.d.ts

# Environment secrets and private key material
.env
.env.*
!.env.example
!.env.sample
.dev.vars
.dev.vars.*
*.pem
*.key
*.p12
*.pfx

# Cloudflare local databases, caches, deployment state
/.wrangler/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# Checkout-local agent/preview state and personal artifacts
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
/.vercel/

# Debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# macOS, Windows, and editor artifacts
.DS_Store
._*
.AppleDouble/
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
/.idea/
/.vscode/

# Keep source, SQL migrations, and package lockfiles tracked.
# This project's build/ directory contains runtime SOURCE, not generated output.
